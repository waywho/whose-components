<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Dummy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dummy">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas text-fg font-sans">
    <main class="container mx-auto mt-28 px-5 flex flex-col gap-4">
      <% if flash[:alert] %>
        <p class="mx-auto w-full max-w-sm rounded-box bg-negative-soft px-3 py-2 text-sm text-negative" role="alert"><%= flash[:alert] %></p>
      <% end %>
      <% if flash[:notice] %>
        <p class="mx-auto w-full max-w-sm rounded-box bg-positive-soft px-3 py-2 text-sm text-positive" role="status"><%= flash[:notice] %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
