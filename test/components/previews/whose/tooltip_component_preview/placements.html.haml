.flex.flex-wrap.items-center.justify-center.gap-24.p-24
  - Whose::TooltipComponent::PLACEMENTS.each_key do |placement|
    = tooltip_component(text: "Tooltip #{placement}", placement:) do |tooltip|
      %button.rounded-box.border.border-border.bg-surface.px-3.py-1.5.text-sm{ type: "button", aria: { describedby: tooltip.id } }= placement
