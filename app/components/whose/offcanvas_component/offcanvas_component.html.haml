%div{ attributes }
  %span.contents{ data: { action: "click->whose-dialog#open" } }= trigger
  %dialog{ class: "m-0 h-dvh max-h-none w-80 max-w-[85vw] border-border bg-surface p-0 font-sans text-fg shadow-xl backdrop:bg-backdrop #{side_style}",
           aria: { labelledby: @title_id },
           data: { side: @side, whose_dialog_target: "dialog" } }
    .flex.h-full.flex-col.gap-4.overflow-y-auto.p-6
      .flex.items-start.justify-between.gap-4
        %h2.text-lg.font-semibold{ id: @title_id }= @title
        %button.shrink-0.cursor-pointer.rounded-box.px-1.opacity-70.hover:opacity-100.focus-visible:outline-2.focus-visible:outline-offset-2.focus-visible:outline-accent{ type: "button", aria: { label: t(".close") }, data: { action: "whose-dialog#close" } } &times;
      .text-sm= content
