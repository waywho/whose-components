%div{ attributes }
  %span.contents{ data: { action: "click->whose-dialog#open" } }= trigger
  %dialog{ class: "m-auto w-full max-w-lg rounded-box border border-border bg-surface p-0 font-sans text-fg shadow-xl backdrop:bg-backdrop",
           aria: { labelledby: title_id },
           data: { whose_dialog_target: "dialog" } }
    .flex.flex-col.gap-4.p-6
      = render Whose::DialogHeaderComponent.new(title: @title, title_id:)
      .text-sm= content
      - if footer?
        .flex.justify-end.gap-2.border-t.border-border.pt-4= footer
