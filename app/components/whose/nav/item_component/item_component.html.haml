%li{ @html_attributes }
  = link_to @href, class: "flex items-center gap-2 rounded-box px-3 py-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent #{link_style}", aria: { current: ("page" if active?) } do
    - if @icon
      %span.shrink-0= @icon
    %span= @label
