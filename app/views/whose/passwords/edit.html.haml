.mx-auto.w-full.max-w-sm
  = render Whose::CardComponent.new do |card|
    - card.with_header do
      %h1.text-lg= t(".title")
    = whose_form_with model: @user, url: password_path(params[:token]), method: :patch do |form|
      .flex.flex-col.gap-4
        = form.password_field :password, label: t(".password"), required: true, autofocus: true,
          autocomplete: "new-password"
        = form.password_field :password_confirmation, label: t(".password_confirmation"), required: true,
          autocomplete: "new-password"
        = form.submit t(".submit"), full: true
