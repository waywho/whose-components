.mx-auto.w-full.max-w-sm
  = render Whose::CardComponent.new do |card|
    - card.with_header do
      %h1.text-lg= t(".title")
    - card.with_footer do
      = render(Whose::LinkComponent.new(href: new_session_path, class: "text-sm")) { t(".sign_in") }
    = whose_form_with url: passwords_path do |form|
      .flex.flex-col.gap-4
        = form.email_field :email_address, label: t(".email_address"), required: true, autofocus: true,
          autocomplete: "username"
        = form.submit t(".submit"), full: true
